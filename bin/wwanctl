#!/usr/bin/env bash
set -u
set -o pipefail

WWAN_DIAG_VERSION="0.1.0"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"

# shellcheck source=../lib/common.sh
. "${PROJECT_ROOT}/lib/common.sh"
# shellcheck source=../lib/system.sh
. "${PROJECT_ROOT}/lib/system.sh"
# shellcheck source=../lib/services.sh
. "${PROJECT_ROOT}/lib/services.sh"
# shellcheck source=../lib/networkmanager.sh
. "${PROJECT_ROOT}/lib/networkmanager.sh"
# shellcheck source=../lib/modemmanager.sh
. "${PROJECT_ROOT}/lib/modemmanager.sh"
# shellcheck source=../lib/hardware.sh
. "${PROJECT_ROOT}/lib/hardware.sh"
# shellcheck source=../lib/bundle.sh
. "${PROJECT_ROOT}/lib/bundle.sh"

usage() {
  cat <<EOF
Usage:
  wwanctl inspect
  wwanctl bundle
  wwanctl version
  wwanctl help

Commands:
  inspect   Print a read-only WWAN diagnostic summary
  bundle    Create a read-only diagnostic tar.gz bundle
  version   Print version
  help      Show this help

v0.1.0 is read-only. It does not restart services, reset modems,
modify NetworkManager profiles, unlock radios, or alter system configuration.
EOF
}

inspect() {
  print_banner
  print_system
  print_services
  print_rfkill
  print_networkmanager
  print_modemmanager
  print_hardware
  print_final_summary
}

case "${1:-help}" in
  inspect)
    inspect
    ;;
  bundle)
    create_bundle
    ;;
  version)
    echo "wwan-diag-kit ${WWAN_DIAG_VERSION}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
